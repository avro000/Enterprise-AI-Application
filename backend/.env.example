# Database
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# RAG Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3

# FAISS Vector Store
FAISS_INDEX_PATH=data/vector_store/faiss.index

# Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Exception Detection Engine
EXCEPTION_CHECK_INTERVAL_MINUTES=15
SLA_RISK_HORIZON_HOURS=48

# CORS
FRONTEND_URL=http://localhost:5173

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
